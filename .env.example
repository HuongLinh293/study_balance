MYSQL_ROOT_PASSWORD=local_root_change_me
# Account mysql-replica uses to read the primary binary log.
MYSQL_REPLICATION_PASSWORD=local_repl_change_me
# One MySQL account per service (used when the MySQL volume is first created).
USER_DB_PASSWORD=local_user_change_me
TASK_DB_PASSWORD=local_task_change_me
PLANNING_DB_PASSWORD=local_planning_change_me
NOTIFICATION_DB_PASSWORD=local_notification_change_me
ANALYTICS_DB_PASSWORD=local_analytics_change_me
RABBITMQ_DEFAULT_USER=studybalance
RABBITMQ_DEFAULT_PASS=local_broker_change_me
# Shared by every service to verify access tokens; at least 32 characters.
JWT_SECRET=local_jwt_secret_change_me_0123456789abcdef
# HTTP port only redirects to HTTPS; open https://localhost:<GATEWAY_HTTPS_PORT>.
GATEWAY_PORT=8080
GATEWAY_HTTPS_PORT=8443

# Google Calendar integration (optional). See docs/google-calendar.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64-encoded. Keep this stable to decrypt stored refresh tokens.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Public origin; Google OAuth redirect URIs are built from it (see docs/google-calendar.md).
APP_PUBLIC_URL=https://localhost:8443

# Database backups (see docs/backup.md): seconds between rounds, rounds to keep.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=7

# Monitoring (see docs/monitoring.md).
GRAFANA_ADMIN_PASSWORD=local_grafana_change_me
