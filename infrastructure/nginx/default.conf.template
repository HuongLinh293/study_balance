# Rendered by the nginx image at start (envsubst): only defined environment
# variables such as ${GATEWAY_HTTPS_PORT} are replaced; $host etc. stay nginx variables.

# Plain HTTP only redirects to HTTPS (308 keeps the method and body).
server {
  listen 80;
  # Old OAuth redirect URIs (http://…:8088) still arrive here: never log their codes.
  location ~ ^/api/user/(integrations|auth)/google/callback$ {
    access_log off;
    return 308 https://$host:${GATEWAY_HTTPS_PORT}$request_uri;
  }
  location / { return 308 https://$host:${GATEWAY_HTTPS_PORT}$request_uri; }
}

server {
  listen 443 ssl;
  http2 on;
  ssl_certificate /etc/nginx/certs/tls.crt;
  ssl_certificate_key /etc/nginx/certs/tls.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:1m;
  ssl_session_timeout 1h;
  # No HSTS: on localhost it would force HTTPS on every other local app too.
  client_max_body_size 1m;
  # Docker's DNS, re-resolved every 10s: a recreated service container gets a new IP
  # and the gateway follows it without a restart (upstreams are variables below).
  resolver 127.0.0.11 valid=10s ipv6=off;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  # Readiness and metrics stay internal; only business routes are exposed.
  location ~ ^/api/[a-z]+/(ready|metrics)$ { return 404; }
  # OAuth authorization codes must never appear in access logs.
  location ~ ^/api/user/(integrations|auth)/google/callback$ {
    access_log off;
    set $user_service user-service;
    proxy_pass http://$user_service:3001/$1/google/callback$is_args$args;
  }
  location ~ ^/api/(user|task|planning|notification|analytics)/(.*)$ {
    set $service $1;
    set $port 3001;
    if ($service = task) { set $port 3002; }
    if ($service = planning) { set $port 3003; }
    if ($service = notification) { set $port 3004; }
    if ($service = analytics) { set $port 3005; }
    # A scaled service resolves to several IPs: Nginx round-robins between them. If one
    # replica refuses the connection or times out, idempotent requests move to the next.
    proxy_next_upstream error timeout http_502 http_503;
    proxy_next_upstream_tries 2;
    proxy_connect_timeout 2s;
    proxy_pass http://$service-service:$port/$2$is_args$args;
  }
  location / {
    set $frontend frontend;
    proxy_pass http://$frontend:80;
  }
}
