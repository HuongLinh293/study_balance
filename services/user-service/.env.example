PORT=3001
DATABASE_URL=mysql://user_app:local_user_change_me@localhost:3306/user_db
RABBITMQ_URL=amqp://studybalance:local_broker_change_me@localhost:5672
# Same value in every service; at least 32 characters.
JWT_SECRET=local_jwt_secret_change_me_0123456789abcdef
# Path the browser sees for /auth (gateway and Vite both serve /api/user/auth).
REFRESH_COOKIE_PATH=/api/user/auth
# true when served over HTTPS.
COOKIE_SECURE=false

# Google Calendar integration (optional). See docs/google-calendar.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64-encoded. Keep this stable to decrypt stored refresh tokens.
GOOGLE_TOKEN_ENCRYPTION_KEY=
APP_PUBLIC_URL=http://localhost:8088
PLANNING_SERVICE_URL=http://localhost:3003
TASK_SERVICE_URL=http://localhost:3002
